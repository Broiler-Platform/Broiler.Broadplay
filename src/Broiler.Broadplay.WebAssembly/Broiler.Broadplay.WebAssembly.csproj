<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;WebPublish-Release</Configurations>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>Broiler.Broadplay.WebAssembly</RootNamespace>
    <AssemblyName>Broiler.Broadplay.WebAssembly</AssemblyName>
    <PublishTrimmed>true</PublishTrimmed>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'WebPublish-Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmBuildOnlyAfterPublish>true</WasmBuildOnlyAfterPublish>
  </PropertyGroup>

  <ItemGroup>
    <WasmEnvironmentVariable Include="BROILER_IMAGE_DECODE_THREADS" Value="1" />
    <WasmEnvironmentVariable Include="BROILER_RASTER_THREADS" Value="1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Graphics.WebAssembly" GeneratePathProperty="true" />
    <PackageReference Include="Broiler.Hosting.WebAssembly" GeneratePathProperty="true" />
    <PackageReference Include="Broiler.Media.Image.Managed" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Broadplay\Broiler.Broadplay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="MainJs" Pattern="main.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <Import Project="BrowserPackageAssets.targets" />

</Project>
