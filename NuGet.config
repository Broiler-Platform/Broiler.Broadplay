<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="broiler-ui-local" value="../Broiler.UI/artifacts/stage-preview" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="broiler-ui-local">
      <package pattern="Broiler.UI" />
      <package pattern="Broiler.UI.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Broiler.UI" />
      <package pattern="Broiler.UI.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
